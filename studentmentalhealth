###############################################################
# step 12:DATA PREPROCESSING
###############################################################

###############################################################
#  Remove Missing Values
###############################################################

data<- na.omit(data)

###############################################################
#  Remove Duplicate Rows
###############################################################

data <- unique(data)

###############################################################
#  Convert Character Columns to Factors
###############################################################

data$Choose.your.gender <- as.factor(data$Choose.your.gender)
data$What.is.your.course. <- as.factor(data$What.is.your.course.)
data$Your.current.year.of.Study <- as.factor(data$Your.current.year.of.Study)
data$What.is.your.CGPA. <- as.factor(data$What.is.your.CGPA.)
data$Marital.status <- as.factor(data$Marital.status)
data$Do.you.have.Depression. <- as.factor(data$Do.you.have.Depression.)
data$Do.you.have.Anxiety. <- as.factor(data$Do.you.have.Anxiety.)
data$Do.you.have.Panic.attack. <- as.factor(data$Do.you.have.Panic.attack.)
data$Did.you.seek.any.specialist.for.a.treatment. <- as.factor(data$Did.you.seek.any.specialist.for.a.treatment.)

###############################################################
# Check Data Types of All Columns
###############################################################
sapply(data, class)

###############################################################
# DATA PREPROCESSING COMPLETED
###############################################################

#saves your cleaned dataset as a new CSV file.
write.csv(data,
          "Student_Mental_Health_Cleaned.csv",
          row.names = FALSE) 

###############################################################
# STEP 13: Split the Dataset into Training and Testing Sets
###############################################################

# Set seed for reproducibility
set.seed(123)

# Split the data (70% training, 30% testing)
split <- sample.split(data$Do.you.have.Depression., SplitRatio = 0.7)

# Create training dataset
train <- subset(data, split == TRUE)

# Create testing dataset
test <- subset(data, split == FALSE)

# Check the number of rows
nrow(train)
nrow(test)

###############################################################
# MACHINE LEARNING USING DECISION TREE
###############################################################

###############################################################
# STEP 14: Train the Decision Tree Model
###############################################################

# Build the Decision Tree model using the training dataset
model <- rpart(
  Do.you.have.Depression. ~
    Age +
    Choose.your.gender +
    Your.current.year.of.Study +
    What.is.your.CGPA. +
    Marital.status +
    Do.you.have.Anxiety. +
    Do.you.have.Panic.attack.,
  data = train,
  method = "class",
  control = rpart.control(maxdepth = 5, cp = 0.005)
)

###############################################################
# STEP 15A: Display Decision Tree Summary
###############################################################

summary(model)

###############################################################
# STEP 15B: Display the Decision Tree
###############################################################

# Display the Decision Tree graph
rpart.plot(
  model,
  type = 2,
  extra = 104,
  fallen.leaves = TRUE,
  cex = 0.8
)

###############################################################
# STEP 16: Predict on the Test Dataset
###############################################################

# Predict depression status for the test dataset
prediction <- predict(
  model,
  newdata = test,
  type = "class"
)

###############################################################
# STEP 17: Create Confusion Matrix
###############################################################

# Compare actual and predicted values
confusion <- table(
  Actual = test$Do.you.have.Depression.,
  Predicted = prediction
)

# Display the confusion matrix
confusion

###############################################################
# STEP 18: Calculate Model Accuracy
###############################################################

# Calculate the accuracy of the Decision Tree model
accuracy <- sum(diag(confusion)) / sum(confusion)

# Display the accuracy
accuracy

# Display accuracy as a percentage
accuracy * 100

###############################################################
# STEP 19: Display Variable Importance
###############################################################

# Display the importance of each predictor variable
model$variable.importance

###############################################################
# STEP 20: Save Decision Tree Plot
###############################################################
#used png() to save the Decision Tree visualization as a PNG image file.
png("Decision_Tree.png", width = 1200, height = 900)
rpart.plot(
  model,
  type = 2,
  extra = 104,
  fallen.leaves = TRUE,
  cex = 0.8
)
dev.off()
#dev.off() closes the graphics device and completes the image file

###############################################################
# DECISION TREE MODEL COMPLETED
###############################################################

