###############################################################
# STEP 2: Clear Workspace
###############################################################

rm(list = ls())

###############################################################
# STEP 3: Load Required Libraries
###############################################################

library(ggplot2)
library(dplyr)
library(caTools)
library(rpart)
library(rpart.plot)


###############################################################
# STEP 4: Import Dataset
###############################################################

data <- read.csv("Student Mental health.csv")

###############################################################
# STEP 5: Explore Dataset
###############################################################

# Display column names
names(data)

# Display first 6 rows
head(data)

# Open dataset in spreadsheet format
View(data)

# Summary statistics
summary(data)

# Structure of dataset
str(data)

# Number of rows and columns
dim(data)

# ======================================================
#  STEP 6: DATA EXPLORATION
# ======================================================

# Display the first 10 rows of the dataset
head(data, 10)

# Display the last 10 rows of the dataset
tail(data, 10)

# Check the class (data type) of each column
sapply(data, class)

# Count the number of observations in the dataset
nrow(data)

# Count the number of variables (columns)
ncol(data)

# Display the column names
colnames(data)

# Display the row names
rownames(data)

# ======================================================
#   STEP 7:CHECKING MISSING VALUES
# ======================================================

# Count missing values in each column
colSums(is.na(data))

# Count total missing values in the dataset
sum(is.na(data))

# ======================================================
# STEP 8:CHECKING DUPLICATES
# ======================================================

# Count duplicate rows
sum(duplicated(data))

# Remove duplicate rows (optional)
data <- distinct(data)

# ======================================================
# STEP 9:SUMMARY STATISTICS
# ======================================================

# Generate descriptive statistics
summary(data)

# Display statistical summary for numeric columns
summary(select_if(data, is.numeric))

# ======================================================
# STEP 10:FREQUENCY TABLES
# ======================================================

# Frequency of Gender
table(data$Choose.your.gender)

# Frequency of Age
table(data$Age)

# Frequency of Course
table(data$What.is.your.course.)

# Calculate the average (mean) age of students
mean(data$Age, na.rm = TRUE)

# Find the middle value (median) of the Age column
median(data$Age, na.rm = TRUE)

# Calculate the standard deviation to measure the spread of Age values
sd(data$Age, na.rm = TRUE)

# Calculate the variance of the Age column
var(data$Age, na.rm = TRUE)

# Find the minimum and maximum Age values
range(data$Age, na.rm = TRUE)

# Find the minimum age
min(data$Age, na.rm = TRUE)

# Find the maximum age
max(data$Age, na.rm = TRUE)

# Find the first quartile, median, and third quartile
quantile(data$Age, na.rm = TRUE)

